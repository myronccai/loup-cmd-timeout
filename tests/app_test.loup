@mode(host.dual)

# Unit tests for timeout's whole command line (cli.app.run): exit statuses for
# help, version, usage errors, and real waits of zero and one second. These
# tests print the program's normal output and error messages.
#
# Runtime: host.dual, run by the test runner: `make test` interprets this file
# with `loup-bootstrap test --no-parallel` (Stage0, source/ on LOUPPATH), one
# test per `func test_*()`. It is not part of the binary.

from debug.assert import (expectEq);
from appinfo import (EXIT_OK, EXIT_FAILURE);
from cli.app import (run);

func test_version_succeeds(): void {
    expectEq(run(["--version"]), EXIT_OK, "--version");
}

func test_help_succeeds(): void {
    expectEq(run(["/?"]), EXIT_OK, "/?");
}

func test_zero_seconds_succeeds(): void {
    expectEq(run(["/T", "0", "/NOBREAK"]), EXIT_OK, "/T 0");
}

func test_one_second_succeeds(): void {
    expectEq(run(["1"]), EXIT_OK, "1");
}

func test_usage_errors(): void {
    let none: list[string] = [];
    expectEq(run(none), EXIT_FAILURE, "no value");
    expectEq(run(["/T"]), EXIT_FAILURE, "/T without a value");
    expectEq(run(["/bogus"]), EXIT_FAILURE, "unknown option");
    expectEq(run(["abc"]), EXIT_FAILURE, "not a number");
    expectEq(run(["-2"]), EXIT_FAILURE, "out of range");
}
