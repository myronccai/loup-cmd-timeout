@mode(host.dual)

# Command-line driver of timeout: parses argv, answers `/?` and `--version`,
# runs the wait, and turns an uncaught exception into `ERROR: message` and
# ERRORLEVEL 1.
#
# Runtime: host.dual. Compiled into the native binary build/timeout by
# `make build`; `loup run source/main.loup` interprets the same code, and
# tests/app_test.loup calls run() directly under Stage0.

from appinfo import (EXIT_OK, EXIT_FAILURE);
from cli.args import (parse_args);
from cli.usage import (usage, version_line);
from commands.timeout import (run_timeout);

# Parses argv, runs timeout and returns the exit status (cmd's ERRORLEVEL).
pub func run(argv: list[string]): int {
    let opts = match parse_args(argv) {
        Ok(parsed) => parsed,
        Err(msg) => {
            printErr(msg);
            return EXIT_FAILURE;
        },
    };

    if (opts.help) {
        println(usage());
        return EXIT_OK;
    }
    if (opts.version) {
        println(version_line());
        return EXIT_OK;
    }

    try {
        return run_timeout(opts.seconds);
    } catch (Exception as e) {
        printErr("ERROR: " + e.message);
        return EXIT_FAILURE;
    }
}
