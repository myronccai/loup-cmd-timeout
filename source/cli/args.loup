@mode(host.dual)

# Command-line parsing for timeout, with the shared Windows switch parser
# (win/switches.loup). The wait may be given as `/T 10`, `/T:10` or just `10`;
# `-1` is a value (wait until CTRL+C), not a switch. Usage errors use the
# wording of Windows' command-line tools, each followed by
# `Type "TIMEOUT /?" for usage.`; an out-of-range value has its own message.
#
# Runtime: host.dual. Compiled into the native binary build/timeout by
# `make build`; `loup run source/main.loup` interprets the same code.
#
# Structure: parse_args() lets parse_switches() split switches from operands,
# then collects the value from `/T` and the operands (each switch at most
# once, unknown options before `--` rejected), insists on exactly one value,
# and checks its range with parse_seconds().

from win.switches import (SwitchSpec, flag, required_value, parse_switches, parse_int_value);

# The range timeout accepts; -1 waits until the program is interrupted.
pub const MIN_SECONDS: int = -1;
pub const MAX_SECONDS: int = 99_999;
pub const WAIT_FOREVER: int = -1;

pub const MSG_TYPE_HELP: string = "Type \"TIMEOUT /?\" for usage.";
pub const MSG_INVALID_VALUE: string = "ERROR: Invalid value for timeout (/T) specified. Valid range is -1 to 99999.";

pub struct Options {
    pub help: bool;
    pub version: bool;
    pub seconds: int;     # -1 to 99999
    pub nobreak: bool;    # /NOBREAK (accepted; every wait ignores keys)
}

# The switches timeout declares.
pub func timeout_switches(): list[SwitchSpec] {
    return [required_value("T"), flag("NOBREAK")];
}

# Options are built here only: a struct constructed in several modules is
# laid out differently by native builds. Callers name the fields they set;
# the others keep their defaults.
func make_options(help: bool = false, version: bool = false, seconds: int = 0,
    nobreak: bool = false): Options {
    return Options(help = help, version = version, seconds = seconds, nobreak = nobreak);
}

# A usage error as timeout prints it: the message, then the pointer to /?.
pub func syntax_error(detail: string): string {
    return "ERROR: " + detail + "\n" + MSG_TYPE_HELP;
}

func repeated(text: string): string {
    return syntax_error("Invalid syntax. '" + text + "' option is not allowed more than '1' time(s).");
}

# Whether an operand is an unknown option rather than a value: it starts
# with `/` or `-` and is not a number (`-1` is a value, `-x` and `/x` are not).
pub func looks_like_option(arg: string): bool {
    if (arg.len() < 2 or !(arg.startsWith("/") or arg.startsWith("-"))) {
        return false;
    }
    let n = match parse_int_value(arg) {
        Some(v) => 1,
        None => 0,
    };
    return n == 0;
}

# The number of arguments after the first `--` (all of them operands).
func count_after_double_dash(argv: list[string]): int {
    var i = 0;
    while (i < argv.len()) {
        if (argv[i] == "--") {
            return argv.len() - i - 1;
        }
        i += 1;
    }
    return 0;
}

# The seconds a value stands for, or None when it is not a whole number in
# the accepted range.
pub func parse_seconds(text: string): Option[int] {
    return match parse_int_value(text) {
        Some(n) if (n >= MIN_SECONDS and n <= MAX_SECONDS) => Some(n),
        _ => None,
    };
}

# The statement form of `match` (arms that return) is deliberate: a match
# expression whose arms build new values returns freed memory natively.
pub func parse_args(argv: list[string]): Result[Options, string] {
    let parsed = match parse_switches(argv, timeout_switches()) {
        Ok(p) => p,
        Err(e) => {
            return Err(syntax_error("Invalid syntax. Value expected for '" + e.text + "'."));
        },
    };
    if (parsed.help or parsed.version) {
        return Ok(make_options(help = parsed.help, version = parsed.version));
    }

    # `/T 5` and a bare `5` are the same value, so both go into `values`;
    # Windows rejects a repeated switch with its own message.
    var values: list[string] = [];
    var t_seen = false;
    var nobreak = false;
    for (sw in parsed.switches) {
        if (sw.name == "T") {
            if (t_seen) {
                return Err(repeated(sw.text));
            }
            t_seen = true;
            values.push(sw.value);
        } else if (sw.name == "NOBREAK") {
            if (nobreak) {
                return Err(repeated(sw.text));
            }
            nobreak = true;
        }
    }

    # Operands before `--` that look like options are errors; after it,
    # everything is a value.
    let checked = parsed.operands.len() - count_after_double_dash(argv);
    var i = 0;
    for (op in parsed.operands) {
        if (i < checked and looks_like_option(op)) {
            return Err(syntax_error("Invalid argument/option - '" + op + "'."));
        }
        values.push(op);
        i += 1;
    }

    if (values.len() == 0) {
        return Err(syntax_error("Invalid syntax. Value expected for '/T'."));
    }
    if (values.len() > 1) {
        return Err(syntax_error("Invalid syntax. Default option is not allowed more than '1' time(s)."));
    }
    let seconds = match parse_seconds(values[0]) {
        Some(n) => n,
        None => {
            return Err(MSG_INVALID_VALUE);
        },
    };
    return Ok(make_options(seconds = seconds, nobreak = nobreak));
}
