@mode(host.dual)

# Help and version text of timeout: what `timeout /?` prints (a short summary
# of this recreation's syntax and switches) and the series' `--version` line.
#
# Runtime: host.dual. Compiled into the native binary build/timeout by
# `make build`; `loup run source/main.loup` interprets the same code.

from appinfo import (APP_NAME, APP_VERSION);

# The text of `timeout /?`: a short summary of this recreation's syntax and
# switches.
pub func usage(): string {
    let lines = [
        "Pause for a number of seconds, showing how many are left.",
        "",
        "TIMEOUT [/T] seconds [/NOBREAK]",
        "",
        "  /T seconds  How long to wait, from -1 to 99999. The /T may be left",
        "              out: TIMEOUT 10 means TIMEOUT /T 10. With -1 the wait",
        "              lasts until CTRL+C is pressed.",
        "  /NOBREAK    Accepted for compatibility. This version never ends the",
        "              wait on a key press, only on CTRL+C.",
        "  /?          Show this summary.",
    ];
    return lines.join("\n");
}

pub func version_line(): string {
    return i"{$ APP_NAME $} (loup-cmd-{$ APP_NAME $}) {$ APP_VERSION $}";
}
