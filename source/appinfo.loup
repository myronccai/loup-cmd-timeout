@mode(host.dual)

# Application identity of timeout: name, version, one-line summary and exit
# statuses. Keep APP_NAME and APP_VERSION in step with `name` and `version` in
# package.lppkg.
#
# Runtime: host.dual. Compiled into the native binary build/timeout by
# `make build`; `loup run source/main.loup` interprets the same code.

pub const APP_NAME: string = "timeout";
pub const APP_VERSION: string = "0.1.0";
pub const APP_SUMMARY: string = "Wait for a number of seconds with a live countdown (a Loup recreation of the Windows timeout command).";

# Exit statuses returned by main(), as cmd's ERRORLEVEL: 0 when the wait
# ends, 1 for a usage error or an invalid timeout value.
pub const EXIT_OK: int = 0;
pub const EXIT_FAILURE: int = 1;
